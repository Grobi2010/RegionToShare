<Window x:Class="RegionToShare.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RegionToShare"
        xmlns:properties="clr-namespace:RegionToShare.Properties"
        Title="{x:Static properties:Resources.Settings_Title}"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="#252526" Foreground="#F1F1F1">
  <Window.Resources>
    <ResourceDictionary Source="DarkTheme.xaml" />
  </Window.Resources>
  <StackPanel Margin="10" DataContext="{x:Static properties:Settings.Default}">
    <StackPanel.Resources>
      <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="5" />
      </Style>
      <Style TargetType="TextBlock" x:Key="Label">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,3,10,3" />
      </Style>
      <Style TargetType="TextBlock" x:Key="Hint">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="#999999" />
        <Setter Property="Margin" Value="0,2,0,3" />
      </Style>
      <Style TargetType="Border" x:Key="ColorPreview">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="5,0,0,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#686868" />
      </Style>
    </StackPanel.Resources>

    <GroupBox Header="{x:Static properties:Resources.Settings_General}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static properties:Resources.Settings_ThemeColor}" />
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBox Width="120" Text="{Binding ThemeColor, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="{x:Static properties:Resources.Settings_ColorHint}" />
          <Border Style="{StaticResource ColorPreview}"
                  Background="{Binding ThemeColor, Converter={x:Static local:ColorBrushConverter.Default}}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static properties:Resources.Settings_FramesPerSecond}" />
        <ComboBox Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" VerticalAlignment="Center"
                  SelectedItem="{Binding FramesPerSecond}"
                  ItemStringFormat="{x:Static properties:Resources.FramesPerSecondFormat}"
                  ItemsSource="{x:Static local:MainWindow.SupportedFramesPerSecond}" />

        <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,3"
                  Content="{x:Static properties:Resources.Settings_DrawShadowCursor}"
                  IsChecked="{Binding DrawShadowCursor}" />

        <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,3"
                  Content="{x:Static properties:Resources.Settings_StartActivated}"
                  IsChecked="{Binding StartActivated}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static properties:Resources.Settings_Language}" />
        <ComboBox Grid.Row="4" Grid.Column="1" Width="160" HorizontalAlignment="Left" VerticalAlignment="Center"
                  ItemsSource="{x:Static local:SettingsWindow.Languages}"
                  DisplayMemberPath="Value" SelectedValuePath="Key"
                  SelectedValue="{Binding Language}" />
        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Hint}"
                   Text="{x:Static properties:Resources.Settings_LanguageRestart}"
                   Visibility="{Binding IsRestartRequired, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:SettingsWindow.BooleanToVisibility}}" />
      </Grid>
    </GroupBox>

    <GroupBox Header="{x:Static properties:Resources.Settings_Hotkeys}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static properties:Resources.Settings_FitWindowHotkey}" />
        <local:HotkeyBox Grid.Row="0" Grid.Column="1" x:Name="FitWindowHotkeyBox" VerticalAlignment="Center"
                         Hotkey="{Binding FitWindowHotkey}"
                         NoneText="{x:Static properties:Resources.Hotkey_None}"
                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                         LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" />
        <StackPanel Grid.Row="1" Grid.Column="1">
          <TextBlock Style="{StaticResource Hint}" Foreground="#FF6060"
                     Text="{x:Static properties:Resources.Settings_HotkeyInUse}"
                     Visibility="{Binding IsFitWindowHotkeyInUse, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:SettingsWindow.BooleanToVisibility}}" />
          <TextBlock Style="{StaticResource Hint}" Text="{x:Static properties:Resources.Settings_HotkeyHint}" />
        </StackPanel>
      </Grid>
    </GroupBox>

    <Button HorizontalAlignment="Right" MinWidth="80" Padding="10,3" IsCancel="True"
            Content="{x:Static properties:Resources.Settings_Close}"
            Click="CloseButton_Click" />
  </StackPanel>
</Window>
